<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Directory.Build.props.local" Condition="Exists('..\..\Directory.Build.props.local')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>EplanEdzManager.EplanBridge</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Eplan29ApiDir Condition="'$(Eplan29ApiDir)' == '' and '$(EPLAN29_API_DIR)' != ''">$(EPLAN29_API_DIR)</Eplan29ApiDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <ProjectReference Include="..\EplanEdzManager.EplanApi\EplanEdzManager.EplanApi.csproj" />
    <ProjectReference Include="..\EplanEdzManager.EplanBridge.Protocol\EplanEdzManager.EplanBridge.Protocol.csproj" />
    <ProjectReference Include="..\EplanEdzManager.Edz\EplanEdzManager.Edz.csproj" />
    <Reference Include="Eplan.EplApi.Starteru">
      <HintPath>$(Eplan29ApiDir)\Eplan.EplApi.Starteru.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Security" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <Target Name="ValidateEplan29StarterReference" BeforeTargets="ResolveReferences">
    <Error Condition="'$(Eplan29ApiDir)' == ''" Text="Set EPLAN29_API_DIR or create Directory.Build.props.local with Eplan29ApiDir." />
    <Error Condition="!Exists('$(Eplan29ApiDir)\Eplan.EplApi.Starteru.dll')" Text="EPLAN 2.9 Starter DLL was not found under '$(Eplan29ApiDir)'." />
  </Target>
</Project>
