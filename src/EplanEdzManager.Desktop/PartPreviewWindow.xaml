<Window x:Class="EplanEdzManager.Desktop.PartPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="部件预览" Icon="Resources/EplanEdzManager.ico" Width="960" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,4,10">
            <TextBlock x:Name="PartTitleText" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="ResourceText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12" />
                <TextBlock x:Name="EmptyMessageText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="15" />
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="4,10,4,0">
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" MinWidth="88" />
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
