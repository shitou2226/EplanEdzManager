<Window x:Class="EplanEdzManager.Desktop.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Phase7.FirstRunTitle}" Width="820" Height="560" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Phase7.BetaLabel}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel><TextBlock Text="EPLAN EDZ Manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Phase7.FirstRunSubtitle}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
        </DockPanel>
        <TabControl x:Name="Steps" Grid.Row="1" SelectionChanged="Steps_SelectionChanged">
            <TabItem Header="{DynamicResource Phase7.StepWelcome}">
                <StackPanel Margin="18"><TextBlock Text="{DynamicResource Phase7.Welcome}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="此工具默认完全本地运行。EPLAN 未安装时仍可使用 Catalog、Search、My Library 与资源导出。不会安装或重新分发 EPLAN API DLL。"/><TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#92400E" Text="Beta 版本未签名；安装与 Add-In 注册状态会如实显示，不伪造 Publisher Trust。"/></StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Phase7.StepEplan}">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="自动检测会核对注册信息、已保存配置和 EPLAN.exe 文件元数据。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="Platform Bin" VerticalAlignment="Center"/><TextBox x:Name="PlatformPathBox" Grid.Row="1" Grid.Column="1" Margin="4"/><Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Phase7.Browse}" Click="BrowsePlatform_Click"/>
                    <TextBlock Grid.Row="2" Text="Variant Bin" VerticalAlignment="Center"/><TextBox x:Name="VariantPathBox" Grid.Row="2" Grid.Column="1" Margin="4"/><Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Phase7.Browse}" Click="BrowseVariant_Click"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="{DynamicResource Phase7.DetectAgain}" Click="Detect_Click" HorizontalAlignment="Left"/>
                    <TextBox x:Name="DetectionText" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150"/>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Phase7.StepApi}">
                <StackPanel Margin="18"><TextBlock Text="EPLAN API 检查" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="ApiText" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" MinHeight="220"/><TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Verified：2.9.4.14642。其它 2.9.x 仅显示 Detected but not verified；2022+ 显示 Unsupported by this build。"/></StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Phase7.StepEdz}">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="选择一个可选的 EDZ Library Folder。只登记路径，不会修改或移动源 EDZ；完成后可在主界面执行扫描。" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBox x:Name="EdzFolderBox" Grid.Row="1" Margin="0,4,8,4"/><Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource Phase7.Browse}" Click="BrowseEdz_Click"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource MutedBrush}" Text="可以留空，稍后从主界面添加。"/>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Phase7.StepDatabase}">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="SQLite 数据库保存 Catalog 索引与 My Library 元数据。升级和默认卸载不会删除它。" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBox x:Name="DatabasePathBox" Grid.Row="1" Margin="0,4,8,4"/><Button Grid.Row="1" Grid.Column="1" Content="选择…" Click="BrowseDatabase_Click"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource MutedBrush}" Text="建议保留默认 LocalAppData 路径。"/>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Phase7.StepAddIn}">
                <StackPanel Margin="18"><TextBlock Text="Add-In：Not detected" FontSize="18" FontWeight="SemiBold"/><TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="DLL 存在不等于已安装。完成首次设置后，请在 EPLAN 中打开 Options / API Add-Ins，并交互选择下方 DLL。"/><TextBox x:Name="AddInPathBox" Margin="0,12,0,0" IsReadOnly="True"/><WrapPanel><Button Content="{DynamicResource Phase7.CopyPath}" Click="CopyAddInPath_Click"/><Button Content="{DynamicResource Phase7.OpenFolder}" Click="OpenAddInFolder_Click"/></WrapPanel></StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Phase7.StepComplete}">
                <StackPanel Margin="18"><TextBlock Text="设置完成" FontSize="20" FontWeight="SemiBold"/><TextBox x:Name="SummaryText" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" MinHeight="240"/><TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="点击“完成”保存本机设置并启动 Desktop。不会扫描、导入或修改任何 EPLAN Project Data。"/></StackPanel>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StepText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="BackButton" Content="{DynamicResource Phase7.Back}" Click="Back_Click"/><Button x:Name="NextButton" Content="{DynamicResource Phase7.Next}" Click="Next_Click"/><Button x:Name="FinishButton" Content="{DynamicResource Phase7.Finish}" Click="Finish_Click" Visibility="Collapsed"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>
