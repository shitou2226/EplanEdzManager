<Window x:Class="EplanEdzManager.Desktop.ImportPartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Safe import to EPLAN Parts Database" Width="1040" Height="760"
        MinWidth="860" MinHeight="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Import selected parts" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Official EPLAN 2.9 API · explicit MDB target · Preview before write" Foreground="#475569" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="8" Margin="0,14,0,12">
            <Border Padding="5" Background="#E2E8F0"><TextBlock Text="1 Selected" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#E2E8F0"><TextBlock Text="2 Database" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#E2E8F0"><TextBlock Text="3 Preview" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#E2E8F0"><TextBlock Text="4 Conflicts" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#E2E8F0"><TextBlock Text="5 Backup" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#FEF3C7"><TextBlock Text="6 Confirm" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#DBEAFE"><TextBlock Text="7 Progress" TextAlignment="Center" /></Border>
            <Border Padding="5" Background="#DCFCE7"><TextBlock Text="8 Result" TextAlignment="Center" /></Border>
        </UniformGrid>

        <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Selected logical parts" VerticalAlignment="Center" />
                <TextBlock x:Name="SelectedCountText" Grid.Column="1" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Validated SelectedParts.edz" VerticalAlignment="Center" />
                <TextBox x:Name="EdzPathText" Grid.Row="1" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseEdz_Click" />
                <TextBlock Grid.Row="2" Text="Target EPLAN 2.9 MDB" VerticalAlignment="Center" />
                <TextBox x:Name="DatabasePathText" Grid.Row="2" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseDatabase_Click" />
                <TextBlock Grid.Row="3" Text="Recent target MDB" VerticalAlignment="Center" />
                <ComboBox x:Name="RecentDatabasesCombo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="4"
                          SelectionChanged="RecentDatabase_SelectionChanged" ToolTip="Shortcut only; no recent path is selected automatically." />
                <TextBlock Grid.Row="4" Text="Target EPLAN data root" VerticalAlignment="Center" />
                <TextBox x:Name="MasterDataRootText" Grid.Row="4" Grid.Column="1" Margin="4" IsReadOnly="True" />
                <Button Grid.Row="4" Grid.Column="2" Content="Browse…" Click="BrowseMasterData_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="StageText" Text="Choose the validated EDZ, target MDB, and target EPLAN data root." FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                <ProgressBar x:Name="ProgressBar" Height="10" IsIndeterminate="False" />
                <TextBlock x:Name="SummaryText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#475569" />
            </StackPanel>
            <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" IsReadOnly="True" Width="120" />
                    <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" IsReadOnly="True" Width="150" />
                    <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="130" />
                    <DataGridTextColumn Header="Differences" Binding="{Binding DifferenceSummary}" IsReadOnly="True" Width="*" />
                    <DataGridComboBoxColumn x:Name="ActionColumn" Header="Action" SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}" Width="115" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="DiagnosticsText" Grid.Row="3" Margin="0,8,0,0" MaxHeight="115" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Click="Close_Click" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
            <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="IMPORT" Click="Import_Click" IsEnabled="False" Background="#B91C1C" Foreground="White" />
            <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="Inspect + Preview" Click="Preview_Click" />
            <Button x:Name="OpenBackupButton" Content="Open Backup Folder" Click="OpenBackup_Click" Visibility="Collapsed" />
            <Button x:Name="ExportReportButton" Content="Export Report" Click="ExportReport_Click" Visibility="Collapsed" />
            <Button x:Name="SkipExistingButton" Content="Skip All Existing" Click="SkipExisting_Click" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
